# ── Server ────────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ── Wiki output (runtime generated, NOT source code) ─────────────────────────
WIKI_OUTPUT_DIR=./data/wiki
WIKI_RAW_DIR=./data/raw

# ── SQLite (HITL queue storage) ───────────────────────────────────────────────
DB_DSN=./data/cim-wiki.db

# ── LLM (OpenAI-compatible; set LLM_BASE_URL for Ollama or local models) ─────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=4096

# ── Parser engines（v2 skill 解析服务端点，本地不做任何文档解析）──────────────
MINERU_ENDPOINT=http://localhost:8888   # MinerU 3.4.2 (复杂 PDF: /file_parse 同步 + /tasks 异步)
MINERU_API_KEY=
DOCLING_ENDPOINT=http://localhost:5001  # Docling service (DOCX/PPTX/HTML)
MARKITDOWN_ENDPOINT=http://localhost:5002  # MarkItDown 备选服务端引擎 (--engine markitdown)

# ── Vector search (Qdrant) ────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=cim_wiki
QDRANT_API_KEY=

# ── Full-text search (Meilisearch) ────────────────────────────────────────────
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=changeme
MEILI_INDEX=cim_wiki

# ── Quality scoring thresholds (POC defaults – calibrate with Golden Dataset) ─
THRESH_L0=0.95   # auto-publish
THRESH_L1=0.80   # expert review
THRESH_L2=0.55   # architect review (below = archive)

# ── Git author for wiki commits ───────────────────────────────────────────────
GIT_AUTHOR_NAME=cim-wiki-bot
GIT_AUTHOR_EMAIL=bot@cim-wiki.local

# Shared-directory knowledge API (required to enable the knowledge service).
# Use a long random token; the Agent uses the same value as CIM_WIKI_TOKEN.
CIM_WIKI_API_TOKEN=
# Any host directory accessible to the Agent and service; no project copy needed.
CIM_WIKI_SHARED_DIR=/mnt/knowledge

# Human-only review credentials; keep separate from the Agent environment.
# JSON object mapping reviewer identity to a distinct random token (>=32 chars).
CIM_WIKI_REVIEW_TOKENS={}

# Server-controlled policy; Agent scores never enable this setting.
CIM_WIKI_AUTO_PUBLISH=false
