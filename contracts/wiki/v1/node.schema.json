{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cim-wiki.local/schemas/v1/node",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "type",
    "plane",
    "product",
    "version",
    "domain",
    "module",
    "source",
    "status",
    "confidence",
    "review_level",
    "reviewer",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "module": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]+$"
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "api_type": {
      "enum": [
        "ui_api",
        "external_integration"
      ]
    },
    "integration_tier": {
      "enum": [
        "engineering",
        "business",
        "automation",
        "quality",
        "logistics"
      ]
    },
    "integration_system": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "isa95_mapping": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "endpoint": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "protocol": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "code_repository": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "code_class": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "code_method": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "git_ref": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "severity": {
      "enum": [
        "Critical",
        "High",
        "Medium",
        "Low"
      ]
    },
    "rule_category": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "verification_status": {
      "enum": [
        "AI-Candidate",
        "Human-Verified",
        "Deprecated"
      ]
    },
    "rule_type": {
      "enum": [
        "contract",
        "business_rule"
      ]
    },
    "granularity": {
      "enum": [
        "micro",
        "macro",
        "contract",
        "business_rule"
      ]
    },
    "domain_object": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "primary_key": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "transaction_code": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "pattern": {
      "enum": [
        "linear",
        "what-next-driven"
      ]
    },
    "review_note": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "schema_version": {
      "const": "1.0"
    },
    "type": {
      "$ref": "https://cim-wiki.local/schemas/v1/node-types"
    },
    "plane": {
      "enum": [
        "doc",
        "code"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "published",
        "archived"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "review_level": {
      "enum": [
        "L0_auto",
        "L1_expert",
        "L2_arch",
        "archive"
      ]
    },
    "source": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "virtual": {
      "type": "boolean"
    },
    "synthesized": {
      "type": "boolean"
    },
    "related_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "related_designs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "related_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "related_apis": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "related_code": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "related_tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "rule_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "applies_to": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "domain_objects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "scenario_variants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "related_modules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "qscore": {
      "type": "object",
      "required": [
        "total"
      ],
      "properties": {
        "total": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "source_location": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "sheet": {
          "type": "string",
          "minLength": 1
        },
        "cells": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "pages": {
          "type": "string",
          "minLength": 1
        },
        "lines": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source",
          "original_uri",
          "original_path",
          "original_sha256",
          "version"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "original_uri": {
            "type": "string",
            "minLength": 1
          },
          "original_path": {
            "type": "string",
            "minLength": 1
          },
          "original_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "ingest_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "template_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "business_rule"
          }
        }
      },
      "then": {
        "required": [
          "rule_type"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "api"
          }
        }
      },
      "then": {
        "required": [
          "api_type"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "frd"
          }
        }
      },
      "then": {
        "required": [
          "pattern"
        ]
      }
    }
  ]
}
