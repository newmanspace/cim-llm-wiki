{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cim-wiki.local/schemas/v1/bundle",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "project",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "project": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "https://cim-wiki.local/schemas/v1/node"
          },
          {
            "required": [
              "title",
              "content"
            ]
          }
        ]
      }
    },
    "source_doc": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "module": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "compiled_at": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "additionalProperties": false
}
