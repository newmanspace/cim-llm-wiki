{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "templates"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "searchPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "templates": {
      "type": "object",
      "propertyNames": {
        "$ref": "https://cim-wiki.local/schemas/v1/node-types"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*\\.md$"
          },
          "plane": {
            "enum": [
              "doc",
              "code"
            ]
          },
          "dir": {
            "type": "string",
            "pattern": "^(doc|code)/[a-z][a-z0-9-]*$"
          },
          "view": {
            "type": "boolean"
          },
          "requiredSections": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^#{2,6} \\S(?:.*\\S)?$"
            }
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "section",
                "columns"
              ],
              "properties": {
                "section": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "columns": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$id": "https://cim-wiki.local/schemas/v1/template"
}
