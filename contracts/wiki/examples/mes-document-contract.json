{
  "schema_version": "1.0",
  "project": "example-mes",
  "modules": ["wip", "equipment"],
  "allow_unlisted": true,
  "documents": [
    {
      "id": "architecture",
      "type": "design",
      "scope": "project",
      "min": 1,
      "max": 1,
      "template": "design-template.md"
    },
    {
      "id": "functional-specifications",
      "type": "frd",
      "scope": "module",
      "min": 1,
      "template": "functional-requirement-template.md",
      "references": [
        { "field": "related_apis", "target_rule": "interfaces", "min": 1, "same_module": true },
        { "field": "related_tests", "target_rule": "tests", "min": 1, "same_module": true }
      ]
    },
    {
      "id": "interfaces",
      "type": "api",
      "scope": "module",
      "min": 1
    },
    {
      "id": "tests",
      "type": "test_case",
      "scope": "module",
      "min": 1,
      "structure": {
        "requiredSections": ["## Preconditions", "## Steps", "## Expected Results"],
        "tables": [
          { "section": "## Steps", "columns": ["Step", "Action", "Expected"] }
        ]
      }
    },
    {
      "id": "user-manual",
      "type": "user-manual",
      "scope": "project",
      "min": 1,
      "template": "user-manual-template.md"
    }
  ]
}
