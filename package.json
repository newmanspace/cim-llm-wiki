{
  "name": "cim-llm-wiki",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "test": "node --test packages/wiki-core/test/*.test.mjs",
    "wiki:validate": "node packages/wiki-core/cli.mjs validate",
    "wiki:compile": "node packages/wiki-core/cli.mjs compile",
    "knowledge:serve": "node packages/wiki-service/server.mjs",
    "lint": "eslint . --max-warnings 0",
    "test:coverage": "c8 npm test",
    "quality:duplicates": "jscpd --config .jscpd.json",
    "quality:lint": "eslint . --max-warnings 0 --format json --output-file reports/eslint.json"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "markdown-it": "^15.0.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "c8": "12.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "jscpd": "5.4.3",
    "typescript-eslint": "8.72.1",
    "vue-eslint-parser": "10.4.2"
  },
  "overrides": {
    "minimatch": "11.0.4",
    "glob": "14.0.3"
  }
}
